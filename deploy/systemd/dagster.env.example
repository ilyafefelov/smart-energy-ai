# Copy to /etc/smart-energy-ai/dagster.env and adjust values for your instance.
DAGSTER_HOME=/var/lib/smart-energy-ai/dagster_home
DAGSTER_MODULE=src.definitions
DAGSTER_PORT=3000
DAGSTER_WEBSERVER_CMD=/opt/smart-energy-ai/.venv/bin/dagster-webserver
DAGSTER_DAEMON_CMD=/opt/smart-energy-ai/.venv/bin/dagster-daemon
PYTHONPATH=/opt/smart-energy-ai
DAGSTER_LOG_LEVEL=INFO
