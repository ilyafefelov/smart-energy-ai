# Smart Energy AI - Environment Variables
# Copy to .env and update with your values
# All settings are validated via Pydantic in src/infrastructure/settings.py

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Option 1: Full URL (recommended for production)
# DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Individual components (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dagster
DB_PASSWORD=dagster
DB_NAME=dagster

# =============================================================================
# WEATHER API (Open-Meteo)
# =============================================================================
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=50.45
WEATHER_LONGITUDE=30.52
WEATHER_TIMEZONE=Europe/Kiev

# =============================================================================
# OREE UKRAINE MARKET DATA
# =============================================================================
OREE_API_URL=https://www.oree.com.ua/
OREE_TIMEOUT_SECONDS=30

# =============================================================================
# S3 STORAGE (for Dagster IO Manager)
# =============================================================================
# Leave empty to use local filesystem
S3_IO_MANAGER_BUCKET=
S3_IO_MANAGER_PREFIX=smart-energy-ai/assets
AWS_REGION=
S3_IO_MANAGER_MAX_RETRIES=3

# =============================================================================
# MLFLOW (Experiment Tracking)
# =============================================================================
# ENERGY_ML_TRACKING_URI=http://localhost:5000
ENERGY_ML_SERVING_MODE=heuristic
ENERGY_ML_MODEL_NAME=battery-optimizer
ENERGY_ML_MODEL_ALIAS=champion

# =============================================================================
# DAGSTER ORCHESTRATION
# =============================================================================
DAGSTER_HOME=data/dagster_home
DAGSTER_HOST=0.0.0.0
DAGSTER_PORT=3000
DAGSTER_LOG_LEVEL=INFO

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# LEGACY / DEPRECATED (kept for reference)
# =============================================================================
# OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast  # Use WEATHER_API_URL
# LOCATION_LAT=50.45  # Use WEATHER_LATITUDE
# LOCATION_LON=30.52  # Use WEATHER_LONGITUDE
