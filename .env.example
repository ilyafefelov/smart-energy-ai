# Smart Energy AI - Environment Variables
# Copy to .env and update with your values

# Database
DATABASE_URL=postgresql://energy_user:dev_password@localhost:5432/smart_energy_ai

# APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OREE_API_URL=https://www.oree.com.ua/

# Location (Kyiv by default)
LOCATION_LAT=50.45
LOCATION_LON=30.52

# Logging
LOG_LEVEL=INFO

# Airflow
AIRFLOW_HOME=/path/to/airflow
AIRFLOW__CORE__DAGS_FOLDER=/path/to/dags

# Notion (for documentation)
NOTION_TOKEN=your_notion_api_token_here
NOTION_DATABASE_ID=your_database_id_here
