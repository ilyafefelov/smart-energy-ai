# OpenWeatherMap API Configuration
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=demo  # Replace with your actual API key from openweathermap.org
OPENWEATHER_LAT=50.45
OPENWEATHER_LON=30.52
OPENWEATHER_UNITS=metric
OPENWEATHER_CACHE_TTL=21600

# OREE API Configuration (Ukrainian energy market)
OREE_API_URL=https://www.oree.com.ua/api/

